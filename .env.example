# Development only. Never commit real credentials.
# Settings use the SL_ environment-variable prefix.
SL_DATABASE_URL=
SL_ENVIRONMENT=development
SL_REAL_EMAIL_ENABLED=false
SL_LOG_LEVEL=INFO
SL_SMTP_HOST=
SL_SMTP_PORT=587
SL_SMTP_USERNAME=
SL_SMTP_PASSWORD=
SL_SMTP_TIMEOUT_SECONDS=30
SL_SCHEDULER_TICK_SECONDS=30

# Phase 2 provider runtime (keep actual values in local env or GitHub Secrets).
TINYFISH_API_KEY=
GROQ_API_KEY=
KEENABLE_API_KEY=
DATA_GOV_IN_API_KEY=
OPENCODE_MODEL=groq/openai/gpt-oss-20b

# QorpIQ public MCP is read-only and does not require an API key.
# Do not add the paid QorpIQ REST key unless a separate budget is approved.
