{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://sentinellayer.invalid/schemas/tracking-event.schema.json",
  "title":"TrackingEvent",
  "type":"object",
  "additionalProperties":false,
  "required":["event_id","schema_version","event_type","occurred_at","source_system","environment","correlation_id","confidence","payload"],
  "properties":{
    "event_id":{"type":"string","format":"uuid"},
    "schema_version":{"type":"string"},
    "event_type":{"type":"string","minLength":1},
    "occurred_at":{"type":"string","format":"date-time"},
    "source_system":{"type":"string","minLength":1},
    "environment":{"type":"string","enum":["development","staging","production"]},
    "account_id":{"type":["string","null"]},
    "person_id":{"type":["string","null"]},
    "campaign_id":{"type":["string","null"]},
    "send_id":{"type":["string","null"]},
    "correlation_id":{"type":"string","minLength":1},
    "causation_id":{"type":["string","null"]},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "payload":{"type":"object"}
  }
}
