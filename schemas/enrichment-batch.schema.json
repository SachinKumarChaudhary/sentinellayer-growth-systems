{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinellayer.invalid/schemas/enrichment-batch.schema.json",
  "title": "EnrichmentBatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "packets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "company_id",
          "domain",
          "company_facts"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "company_id": {
            "type": "integer",
            "minimum": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "merchant_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "company_contacts": {
            "type": "array"
          },
          "decision_makers": {
            "type": "array"
          },
          "intent_signals": {
            "type": "array"
          },
          "personalization_angle": {
            "type": [
              "string",
              "null"
            ]
          },
          "research_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "company_facts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "employee_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "monthly_sessions": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "has_login": {
                "type": "boolean"
              },
              "vertical": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ownership_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "india_bridge": {
                "type": "boolean"
              },
              "data_sensitivity": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
