{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinellayer.invalid/schemas/shared-contracts.schema.json",
  "title": "SentinelLayer Shared Contract Definitions",
  "description": "Common schema primitives used by cross-system contracts. Individual contract schemas may reference these definitions.",
  "$defs": {
    "uuid": {"type":"string","format":"uuid"},
    "timestamp": {"type":"string","format":"date-time"},
    "correlation_id": {"type":"string","minLength":1},
    "confidence": {"type":"number","minimum":0,"maximum":1},
    "priority": {"type":"string","enum":["P1","P2","P3","P4"]},
    "base": {
      "type":"object",
      "required":["schema_version"],
      "properties":{"schema_version":{"type":"string"}}
    }
  }
}
