{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinellayer.local/schemas/event-envelope.schema.json",
  "title": "SentinelLayer Canonical Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "source_system",
    "environment",
    "correlation_id",
    "schema_version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_system": {
      "type": "string",
      "enum": [
        "account_intelligence",
        "decision_maker_intelligence",
        "intent",
        "mail",
        "campaign",
        "tracking",
        "conversation",
        "sales",
        "analytics",
        "operations"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "account_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "person_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "lead_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "campaign_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "send_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
