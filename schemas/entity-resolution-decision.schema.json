{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SentinelLayer Entity Resolution Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id","contract_version","lead_id","status","canonical_entity_id",
    "entity_type","canonical_name","canonical_domain","confidence",
    "decisive_signals","rejected_candidates","comparisons","decision_trace",
    "evidence_refs","currentness","relationships","research_required",
    "research_missions","unresolved_questions","matching_version","decided_at"
  ],
  "properties": {
    "decision_id": {"type":"string","minLength":1},
    "contract_version": {"const":"phase2.entity_resolution.v1"},
    "lead_id": {"type":"string","minLength":1},
    "status": {"enum":["MATCHED","MATCHED_WITH_RELATIONSHIP","AMBIGUOUS","CONFLICT","UNRESOLVED","NO_MATCH"]},
    "canonical_entity_id": {"type":["string","null"]},
    "entity_type": {"enum":["LEGAL_ENTITY","OPERATING_ENTITY","BRAND","BUSINESS_UNIT","PARENT_COMPANY","HOLDING_COMPANY","FRANCHISEE","LICENSOR","LICENSEE","EXTERNAL_PROVIDER","UNKNOWN"]},
    "canonical_name": {"type":["string","null"]},
    "canonical_domain": {"type":["string","null"]},
    "confidence": {"enum":["high","medium","low","unknown"]},
    "decisive_signals": {"type":"array","items":{"type":"string"}},
    "rejected_candidates": {"type":"array","items":{"type":"string"}},
    "comparisons": {"type":"array","items":{"$ref":"#/$defs/comparison"}},
    "decision_trace": {"type":"array","items":{"$ref":"#/$defs/trace"}},
    "evidence_refs": {"type":"array","items":{"type":"string"}},
    "currentness": {"enum":["CURRENT","HISTORICAL","UNKNOWN","NOT_ESTABLISHED","CONFLICT"]},
    "relationships": {"type":"array","items":{"$ref":"#/$defs/relationship"}},
    "research_required": {"type":"boolean"},
    "research_missions": {"type":"array","items":{"type":"string"}},
    "unresolved_questions": {"type":"array","items":{"type":"string"}},
    "matching_version": {"const":"phase2.deterministic_match.v1"},
    "decided_at": {"type":"string","format":"date-time"}
  },
  "$defs": {
    "signal": {
      "type":"object","additionalProperties":false,
      "required":["code","strength","weight","value","reason"],
      "properties":{
        "code":{"type":"string"},"strength":{"enum":["strong","medium","weak","negative"]},
        "weight":{"type":"integer"},"value":{"type":"boolean"},"reason":{"type":"string"}
      }
    },
    "comparison": {
      "type":"object","additionalProperties":false,
      "required":["candidate_id","score","signals","hard_negative","eligible_for_match"],
      "properties":{
        "candidate_id":{"type":"string"},"score":{"type":"integer"},
        "signals":{"type":"array","items":{"$ref":"#/$defs/signal"}},
        "hard_negative":{"type":"boolean"},"eligible_for_match":{"type":"boolean"}
      }
    },
    "trace": {
      "type":"object","additionalProperties":false,
      "required":["step","detail"],
      "properties":{
        "step":{"type":"string"},"detail":{"type":"string"},"candidate_id":{"type":["string","null"]}
      }
    },
    "relationship": {
      "type":"object","additionalProperties":false,
      "required":[
        "relationship_id","subject_entity_id","predicate","object_entity_id",
        "function_scope","valid_from","valid_to","currentness","evidence_refs",
        "status","adjudication_reason"
      ],
      "properties":{
        "relationship_id":{"type":"string"},
        "subject_entity_id":{"type":"string"},
        "predicate":{"enum":["SAME_ENTITY_AS","BRAND_OF","SUBSIDIARY_OF","OWNED_BY","OPERATES","BUSINESS_UNIT_OF","PARENT_OF","FRANCHISE_OF","LICENSED_FROM","LICENSED_TO","PROVIDES_SERVICE_TO","FUNCTIONALLY_CONTROLS","FORMERLY_OWNED_BY","ACQUIRED","DIVESTED","UNKNOWN_RELATIONSHIP"]},
        "object_entity_id":{"type":"string"},
        "function_scope":{"type":["string","null"]},
        "valid_from":{"type":["string","null"],"format":"date-time"},
        "valid_to":{"type":["string","null"],"format":"date-time"},
        "currentness":{"enum":["CURRENT","HISTORICAL","UNKNOWN","NOT_ESTABLISHED","CONFLICT"]},
        "evidence_refs":{"type":"array","items":{"type":"string"}},
        "status":{"enum":["ESTABLISHED","NOT_ESTABLISHED","CONFLICT","UNKNOWN"]},
        "adjudication_reason":{"type":"string"}
      }
    }
  }
}
