{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinellayer.invalid/schemas/canonical-lead.schema.json",
  "title": "CanonicalLead",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lead_id",
    "source_refs",
    "field_observations",
    "normalization_version",
    "raw_fingerprint",
    "source_fingerprint",
    "canonical_fingerprint",
    "quality_status",
    "quality_finding_ids",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "lead_id": {
      "type": "string",
      "minLength": 3
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "legal_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "country_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "postal_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "field_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldObservation"
      }
    },
    "normalization_version": {
      "type": "string",
      "minLength": 1
    },
    "raw_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonical_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "quality_status": {
      "enum": [
        "ACCEPTED",
        "ACCEPTED_WITH_WARNINGS",
        "QUARANTINED",
        "REJECTED",
        "DUPLICATE"
      ]
    },
    "quality_finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "fieldObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "lead_id",
        "source_record_id",
        "field",
        "source_field_name",
        "raw_value",
        "normalized_value",
        "value_state",
        "observed_at",
        "adapter_version",
        "normalization_version",
        "transformation_reason"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "minLength": 3
        },
        "lead_id": {
          "type": "string",
          "minLength": 3
        },
        "source_record_id": {
          "type": "string",
          "minLength": 3
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "source_field_name": {
          "type": "string",
          "minLength": 1
        },
        "raw_value": {},
        "normalized_value": {},
        "value_state": {
          "enum": [
            "observed",
            "normalized",
            "missing",
            "invalid",
            "conflicting"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "normalization_version": {
          "type": "string",
          "minLength": 1
        },
        "transformation_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
